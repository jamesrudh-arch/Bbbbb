; LEVERAGE — Cinder City
; Engine: Godot 4.7.2-stable, Mobile renderer (Vulkan/Metal), target: iPhone via Xogot.
; This file is the single project configuration. Do not duplicate.

config_version=5

[application]

config/name="LEVERAGE"
config/description="Everyone has leverage on you."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.047, 0.059, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Content="*res://scripts/autoload/content.gd"
Game="*res://scripts/autoload/game.gd"
Events="*res://scripts/autoload/events.gd"
Audio="*res://scripts/autoload/audio_director.gd"
Loader="*res://scripts/autoload/scene_loader.gd"
SaveFlags="*res://scripts/autoload/save_flags.gd"
PlatformUI="*res://scripts/autoload/platform_ui.gd"
Crash="*res://scripts/autoload/crash_reporter.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="vehicle"
3d_physics/layer_5="interactable"
3d_physics/layer_6="hitbox"
3d_physics/layer_7="trigger"
3d_physics/layer_8="camera_block"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.25

[physics]

3d/default_gravity=18.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=1
textures/default_filters/texture_mipmap_bias=0.0
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.059, 1)
driver/depth_prepass/enable=true
textures/vram_compression/import_etc2_astc=true

[threading]

worker_pool/max_threads=2
