extends RefCounted
## SURFACE DETAIL — shared procedural albedo texture, generated by the engine.
##
## Every static surface in the city was a flat colour, and flat colour is what
## makes a scene read as "untextured blocks": a road with one grey value has no
## scale, a wall with one paint value has no age. The fix is not a downloaded
## brick/asphalt/siding atlas - that would cost tens of MB in the export and in
## VRAM on a phone - it is a small tiling noise texture used three ways:
##
##   * asphalt: a tight grain, multiplied over the road colour
##   * pavement: a coarser mottle, so slabs read as separate slabs
##   * walls: a broad low-contrast stain, so facades are not uniform
##
## This is built on FastNoiseLite + NoiseTexture2D rather than a hand-written
## pixel loop. A first version generated the image in GDScript, which cost about
## 570 ms of world load - unacceptable on a phone, where GDScript is slower than
## on the desktop machine it was measured on. The engine generates the same image
## on a background thread in native code for effectively nothing, and it needs no
## import step, so Xogot's first-open reimport cannot break it.
##
## Both textures are cached per process: the whole city shares two images.

const SIZE := 256

static var _grain: NoiseTexture2D = null
static var _mottle: NoiseTexture2D = null

## Fine high-frequency grain. Road surface, concrete, corrugated metal.
static func grain() -> NoiseTexture2D:
	if _grain != null:
		return _grain
	_grain = _make(26.0, 0.55, 3)
	return _grain

## Coarse, softer mottle. Paintwork, plaster, paving slabs.
static func mottle() -> NoiseTexture2D:
	if _mottle != null:
		return _mottle
	_mottle = _make(9.0, 0.40, 4)
	return _mottle

## `freq` is noise frequency in cycles per texture (higher = finer detail),
## `contrast` the spread around mid-grey, `octaves` the detail layers.
static func _make(freq: float, contrast: float, octaves: int) -> NoiseTexture2D:
	var n := FastNoiseLite.new()
	n.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	n.seed = 0xC1DE5           # fixed: the city must look identical every load
	n.frequency = freq / float(SIZE)
	n.fractal_type = FastNoiseLite.FRACTAL_FBM
	n.fractal_octaves = octaves
	n.fractal_gain = 0.5
	var t := NoiseTexture2D.new()
	t.width = SIZE
	t.height = SIZE
	t.seamless = true          # tiles without a visible join on a long road
	t.noise = n
	t.as_normal_map = false
	# Remap the noise into a light-range grey: this is a multiplier on the albedo,
	# so it must sit near white. A dark texture would blacken the whole city.
	var grad := Gradient.new()
	grad.set_color(0, Color(1.0 - contrast, 1.0 - contrast, 1.0 - contrast))
	grad.set_color(1, Color(1.0, 1.0, 1.0))
	t.color_ramp = grad
	t.generate_mipmaps = true
	return t
